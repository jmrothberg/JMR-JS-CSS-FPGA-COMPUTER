# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local / generated
/card*.img
!/card.img
card.img~
*.log
vivado.jou
vivado.log
# Vivado reports written into the working folder
/audio_reset_exceptions.rpt
/clockInfo.txt
/tight_setup_hold_pins.txt
.Xil/
scripts/vivado_env.sh

# Build / sim outputs (regenerate)
build/
sim/sim_build*/
sim/sim_build_*/

# Retired files awaiting deletion.
/to_be_deleted/

# Editor
.vscode/
*.swp
*~

# Traces may be large; keep directory, ignore noise if needed later
# traces/*.log is kept for now so session flight logs can be committed when useful

# Vivado writes these when it cannot open its normal journal — pure noise
vivado_*.backup.jou
vivado_*.backup.log

# Vivado stages these from the canonical vectors/ ROMs beside the RTL sources.
/rtl/engines/desktop_*.hex
/rtl/video/desktop_*.hex

# Generated UI ROM staging copies; authoritative images live in vectors/.
/rtl/engines/system_*.hex
/rtl/video/system_*.hex
/rtl/engines/classic_records.hex
/rtl/video/classic_records.hex

# Canonical ROMs are in vectors/. The build copies them beside the RTL and into sim/.
/rtl/engines/classic_static.hex
/rtl/video/classic_static.hex
/rtl/engines/font_rom.hex
/rtl/video/font_rom.hex
/rtl/engines/invaders_jsb.hex
/sim/classic_*.hex
/sim/system_*.hex
/sim/desktop_*.hex
/sim/font_rom.hex
/sim/invaders_jsb.hex
# Generated resident Toolbox copies; canonical words remain in vectors/.
/rtl/engines/toolbox_code*.hex
/sim/toolbox_code*.hex

# GUI session logs
/traces/*.log
/traces/pytest/

# Clone of https://github.com/jmechner/Prince-of-Persia-Apple-II (its own git repo)
Prince/Prince-of-Persia-Apple-II/
