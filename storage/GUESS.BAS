10 REM GUESS - THE CLASSIC NUMBER GUESSING GAME
20 CLS:RANDOM
30 PRINT "I AM THINKING OF A NUMBER FROM 1 TO 100."
40 N=RND(100):T=0
50 INPUT "YOUR GUESS";G
60 T=T+1
70 IF G<N THEN PRINT "TOO LOW.":GOTO 50
80 IF G>N THEN PRINT "TOO HIGH.":GOTO 50
90 PRINT "RIGHT! YOU GOT IT IN";T;"TRIES."
100 INPUT "PLAY AGAIN (Y/N)";A$
110 IF LEFT$(A$,1)="Y" THEN 30
120 END
