10 REM SINE - TRS-80 BLOCK GRAPHICS WITH SET (128 X 48 POINTS)
20 CLS
30 FOR X=0 TO 127:SET(X,24):NEXT X
40 FOR Y=4 TO 44:SET(64,Y):NEXT Y
50 FOR X=0 TO 127
60 SET(X,24-INT(20*SIN((X-64)/10)))
70 NEXT X
80 PRINT @ 0,"Y = SIN(X)";
90 PRINT @ 960,"PRESS ANY KEY";
100 IF INKEY$="" THEN 100
110 CLS:END
